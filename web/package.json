{
  "name": "farm-to-stars-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "migrate": "node scripts/migrate/run.mjs",
    "build:rc": "node scripts/release/createRcBuild.mjs",
    "build:playtest": "node scripts/release/buildPlaytest.mjs",
    "profile:homestead": "node scripts/profile/profileHomestead.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.0",
    "idb-keyval": "^6.2.1",
    "howler": "^2.2.4",
    "tone": "^14.8.49"
  },
  "devDependencies": {
    "@types/node": "^22.8.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vitest": "^0.5.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
